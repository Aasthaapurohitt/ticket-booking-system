# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seat hold / waitlist timing (seconds)
HOLD_TTL_SECONDS=600
WAITLIST_OFFER_TTL_SECONDS=900
SWEEP_INTERVAL_MS=15000

# Database (SQLite file path; default is server/data/app.db)
DB_PATH=./data/app.db

# Email (SMTP) - leave blank to use an auto-created Ethereal test inbox.
# Any free-tier SMTP provider works, e.g.:
#   Gmail:      smtp.gmail.com / 587  (use an App Password, not your real password)
#   Brevo:      smtp-relay.brevo.com / 587
#   Mailtrap:   sandbox.smtp.mailtrap.io / 2525
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ticket Booking" <noreply@ticketbooking.dev>
